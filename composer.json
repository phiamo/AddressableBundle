{
    "name": "daa/addressable-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle to make entities addressable and geo spacial services for searching and comparing their latitude/longitude",
    "authors": [
        {
            "name": "Daniel Antelo",
            "homepage": "https://github.com/danielantelo"
        }
    ],
    "require": {
        "php": ">=7.2 || >=8.0",
        "symfony/form": "@stable",
        "symfony/http-kernel": "@stable",
        "symfony/dependency-injection": "@stable",
        "symfony/config": "@stable",
        "symfony/validator": "@stable",
        "symfony/options-resolver": "@stable",
        "doctrine/orm": "^2"
    },
    "autoload": {
        "psr-4": { 
            "Addressable\\Bundle\\": ""
        }
    },
    "require-dev": {
        "rector/rector": "^1.2"
    }
}
